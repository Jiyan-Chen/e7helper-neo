{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "第七史诗助手",
  "mainBinaryName": "e7helper",
  "version": "0.1.0",
  "identifier": "com.e7helper.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "第七史诗助手",
        "width": 1280,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0b1120"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "e7helper",
    "shortDescription": "第七史诗国服 · MuMu 模拟器助手",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
