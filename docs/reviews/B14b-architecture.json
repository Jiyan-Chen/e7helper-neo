  "cards": [
    {
      "dot": "cyan",
      "title": "一场 = 一条序列",
      "items": [
        "每个 token = 英雄嵌入 + 类型嵌入（7 种）+ 位置嵌入（同一方两个预禁共用一个位置）",
        "0–4 互相可见、之后因果：一次前向读出 12 个局面，不用每场拆 12 条样本",
        "胜率一律是先手方赢的概率，后手方 = 1 − p",
        "每边第 3 手是保护位，由位置嵌入区分"
      ]
    },
    {
      "dot": "emerald",
      "title": "训练",
      "items": [
        "损失 = 12 个局面胜率 BCE 平均 + λ × 10 个局面选人交叉熵平均；早停只看胜率",
        "选人标签：连选 2 名的回合两名各 0.5；PAD、被预禁、已选的屏蔽",
        "ss21 两服合并 91 万场：训练 49.6 万 / 验证 19.2 万 / 测试 22.3 万（按日期）",
        "GPU：ROCm torch 2.9（RX 7700 XT，比 CPU 快约 16 倍）；验证集上每个局面拟合 Platt 校准"
      ]
    },
    {
      "dot": "violet",
      "title": "对比的基线",
      "items": [
        "B0：先手 + 段位 + 开战规则（逻辑回归）",
        "B1：B0 + 每名英雄一个强度",
        "B2：因子分解机（强度 + 搭档 + 克制，先后手反对称）——混合结构的宽部分就是它",
        "纯 Transformer（没有宽部分）：学得慢，后禁信息几乎用不上",
        "选人：每个局面的英雄热度"
      ]
    },
    {
      "dot": "amber",
      "title": "部署",
      "items": [
        "torch.onnx.export（opset 18，批次维动态）→ engine/assets/data/rta/model.onnx",
        "meta.json（词表、规则编号、温度 T、测试指标）+ parity.json（一致性样例）",
        "运行时 core/rta/model.py 用 onnxruntime 推理，不需要 torch",
        "给 B14c 选秀搜索：一次前向给一批局面的胜率和下一手分布"
      ]
    }
